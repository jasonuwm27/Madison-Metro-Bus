[Unit]
Description=Create upcoming weekly partitions
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=opc
Group=opc
WorkingDirectory=/opt/bus/repo
ExecStart=/usr/bin/node --import tsx/esm scripts/partitions.ts
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bus-partitions
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/mnt/pgdata/archive /opt/bus/repo
