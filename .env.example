# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string.
#
# Prefer the *session* pooler (port 5432) or a direct connection so prepared
# statements work. If you use the transaction pooler (port 6543), you MUST set
# PGPREPARE=false below — Supavisor in transaction mode cannot hold prepared
# statements across checkouts and postgres.js will error without it.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Set to false only when DATABASE_URL points at the transaction pooler (:6543).
PGPREPARE=true

# Max pool size. The worker is a single process doing batched writes; it does
# not need many connections, and Supabase's free tier caps them.
PGPOOL_MAX=4

# ---------------------------------------------------------------------------
# Feed endpoints (verified live 2026-09-15, no API key required)
# ---------------------------------------------------------------------------
GTFSRT_TRIP_UPDATES_URL=https://metromap.cityofmadison.com/gtfsrt/trips
GTFSRT_VEHICLE_POSITIONS_URL=https://metromap.cityofmadison.com/gtfsrt/vehicles
GTFSRT_ALERTS_URL=https://metromap.cityofmadison.com/gtfsrt/alerts
GTFS_STATIC_URL=https://transitdata.cityofmadison.com/GTFS/mmt_gtfs.zip

# ---------------------------------------------------------------------------
# Polling
# ---------------------------------------------------------------------------
# TripUpdates and VehiclePositions are polled fast; Alerts change rarely.
POLL_INTERVAL_TRIPS_MS=30000
POLL_INTERVAL_VEHICLES_MS=30000
POLL_INTERVAL_ALERTS_MS=300000

# Per-request timeout, and retry/backoff for a failing feed. Backoff is
# exponential with full jitter and is capped — the worker never gives up, it
# just slows down, so an overnight Metro outage self-heals without a restart.
FETCH_TIMEOUT_MS=20000
FETCH_MAX_RETRIES=4
BACKOFF_BASE_MS=1000
BACKOFF_MAX_MS=120000

# ---------------------------------------------------------------------------
# Archive (record of record — every raw payload, hourly gzipped NDJSON)
# ---------------------------------------------------------------------------
# "local" needs no cloud account and is the default so collection can start
# immediately. "r2" additionally uploads each closed hourly shard.
ARCHIVE_SINK=local
ARCHIVE_DIR=./archive

# gzip (default) or brotli. Measured on a real 131,904-byte TripUpdates payload:
#   gzip   54,307 B/poll  ~4.7 GB/month  -- universal, reads anywhere
#   brotli 43,076 B/poll  ~3.7 GB/month  -- 21% smaller, identical NDJSON
# The shard extension (.gz / .br) records which was used.
ARCHIVE_COMPRESSION=gzip

# Cloudflare R2 (S3-compatible). Only read when ARCHIVE_SINK=r2.
R2_ACCOUNT_ID=
R2_BUCKET=madison-gtfsrt-archive
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Delete the local shard after a successful R2 upload. Keep false until you
# have confirmed uploads are landing.
ARCHIVE_DELETE_LOCAL_AFTER_UPLOAD=false

# ---------------------------------------------------------------------------
# Timezone / service-day derivation
# ---------------------------------------------------------------------------
# Madison Metro operates in America/Chicago. Trip updates carry no start_date,
# so the service date is derived by matching against the static schedule in
# this zone. Do not change this unless the agency changes.
AGENCY_TIMEZONE=America/Chicago

# ---------------------------------------------------------------------------
# Health
# ---------------------------------------------------------------------------
# Pinged after each successful TripUpdates poll cycle. Worker death is the only
# unrecoverable failure mode, so set this up. Free options: healthchecks.io,
# Better Stack. Configure the check to alert after 20 minutes of silence.
HEALTHCHECK_URL=
HEALTHCHECK_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info
# "pretty" for human-readable local dev; "json" for production log shipping.
LOG_FORMAT=json
