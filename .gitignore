node_modules/
dist/
.env
.env.local
*.log

# Local archive spool -- raw feed captures live here before upload.
# By default these live OUTSIDE the repo (C:\bus-archive on Windows), but these
# patterns stay so that pointing ARCHIVE_DIR back inside the tree cannot
# accidentally commit gigabytes of shards. Matches at any depth.
# Anchored to the repo root so it cannot match src/archive/, which is SOURCE.
# An earlier unanchored `**/archive/` silently excluded src/archive/*.ts from
# the repo -- the push looked fine locally because the files existed on disk,
# and only failed on a clean clone. Leading slash = repo root only.
/archive/
/bus-archive/
/data/
*.ndjson.gz
*.ndjson.br
*.ndjson.gz.partial
*.ndjson.br.partial

# Downloaded GTFS static zips and extracted CSVs.
.gtfs-cache/
**/.gtfs-cache/

# SSH keys and other credential material. The repo is public, and a `git add .`
# would otherwise sweep these in. `.key` was created empty in the project root
# at one point -- this makes that class of mistake unstageable.
*.key
*.pem
*.ppk
.key
id_rsa*
id_ed25519*

# Exported site data: 1,464 shards regenerated from the database on demand.
# Derived, bulky, and changes nightly -- it belongs in a deploy artifact, not
# in git history.
site/public/data/
