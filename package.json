{
  "name": "madison-bus-reliability",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Archives Madison Metro GTFS-RT feeds to build historical on-time performance data.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "worker": "tsx src/worker.ts",
    "worker:prod": "node dist/worker.js",
    "load-static": "tsx src/static/load.ts",
    "rollup": "tsx scripts/rollup.ts",
    "partitions": "tsx scripts/partitions.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "upload-archive": "tsx scripts/upload-archive.ts",
    "diff-db": "tsx scripts/diff-databases.ts",
    "backup-db": "tsx scripts/backup-database.ts",
    "summary": "tsx scripts/weekly-summary.ts",
    "export-site": "tsx scripts/export-site.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "adm-zip": "^0.5.16",
    "csv-parse": "^5.6.0",
    "dotenv": "^17.4.2",
    "gtfs-realtime-bindings": "^2.2.0",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
